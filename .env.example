# Datadog — prefer a Personal or Service Access Token (Bearer).
# Create at https://celonis.datadoghq.com/personal-settings/access-tokens
# Secret starts with ddpat_ (personal) or ddsat_ (service). Shown only once.
# Scopes: monitors_read, slos_read, incident_read
#
#   DD_ACCESS_TOKEN=ddpat_...
#   DD_SITE=https://api.datadoghq.com
#
# Legacy fallback (API key + application key) still works:
#   DD_API_KEY=...
#   DD_APP_KEY=...

DD_ACCESS_TOKEN=
DD_API_KEY=
DD_APP_KEY=
DD_SITE=https://api.datadoghq.com
HTTP_TIMEOUT=45

# Roadie / Backstage Tech Insights scorecards (celonis.roadie.so).
# Create a User Token at https://celonis.roadie.so/administration
# (Roadie API Access). Never commit the token.
#
#   ROADIE_API_TOKEN=...
#   ROADIE_API_BASE=https://api.roadie.so/api
#   ROADIE_APP_BASE=https://celonis.roadie.so

ROADIE_API_TOKEN=
ROADIE_API_BASE=https://api.roadie.so/api
ROADIE_APP_BASE=https://celonis.roadie.so

# Google Drive — Task Mining squad shared folder (docs + KT recordings).
# Scored from Google Drive for Desktop metadata on this Mac. Open the folder
# once while signed in so it is in the local cache.
#
#   GOOGLE_DRIVE_FOLDER_ID=1fB6CtN8Gh2L0RtwBXv31Iy546H5BpkD4

GOOGLE_DRIVE_FOLDER_ID=1fB6CtN8Gh2L0RtwBXv31Iy546H5BpkD4

# Celocore Code Purple metrics (Studio view, US-2).
# User API key (Edit Profile) → CELONIS_API_TOKEN (Bearer).
# Application key (Admin & Settings → Applications) → CELONIS_APP_KEY.
# Grant USE PACKAGE on the Code Purple Studio package.

CELONIS_API_TOKEN=
CELONIS_APP_KEY=
CELONIS_TEAM=https://celocore.us-2.celonis.cloud

# GitHub — live PR / protection / release metrics for origin remote.
# Classic PAT: https://github.com/settings/tokens  (repo or public_repo)
#
#   GITHUB_TOKEN=ghp_...
#   GITHUB_API_BASE=https://api.github.com

GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# Jira — CBE / security / feature / bug counts (celonis.atlassian.net).
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Sibling onboarding-readiness/.env JIRA_* is also picked up.
#
#   JIRA_EMAIL=you@celonis.com
#   JIRA_TOKEN=...
#   JIRA_SITE=https://celonis.atlassian.net

JIRA_EMAIL=
JIRA_TOKEN=
JIRA_SITE=https://celonis.atlassian.net

# Kargo UI. Project comes from repo-depot.celonis.dev/image-name
# (cloud/task-mining → /project/cloud-task-mining). Override the host or set
# catalog annotation handover.celonis.dev/kargo-url.
KARGO_BASE=https://kargo.us-2.celonis.cloud

# Confluence / Celospace — docs, SOPs, runbooks, handover pages.
# Same Atlassian API token as Jira (email + token). Site is the wiki, not Jira.
# Default hub is the Task Mining page in space DKB.
#
#   CONFLUENCE_SITE=https://celonis-confluence.atlassian.net
#   CONFLUENCE_EMAIL=  (optional; falls back to JIRA_EMAIL)
#   CONFLUENCE_TOKEN=  (optional; falls back to JIRA_TOKEN)
#   CONFLUENCE_SPACE=DKB
#   CONFLUENCE_ANCESTOR=17674883

CONFLUENCE_SITE=https://celonis-confluence.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE=DKB
CONFLUENCE_ANCESTOR=17674883
